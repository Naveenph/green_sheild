# General App Settings
SECRET_KEY=replace-with-a-secure-random-key

# Database Connection URL
# For local XAMPP MySQL (default: username 'root', no password, database 'greenshield_db')
DATABASE_URL=mysql+pymysql://root:@localhost/greenshield_db

# (Optional) If using custom MySQL credentials:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/greenshield_db

# (Optional) If using Supabase Cloud PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:port/database

# (Optional) Supabase Storage Configuration (for cloud image hosting)
# If left blank or comment out, the app will save images locally in 'static/uploads/'
# SUPABASE_KEY=your_supabase_anon_key_here
# SUPABASE_BUCKET_NAME=greenshield-scans

# (Optional) Google Gemini API Key for advanced plant analysis
GEMINI_API_KEY=your_gemini_api_key_here
# (Optional) Kaggle API Credentials for downloading model datasets
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
